<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.modbuddesktopproject.controller.ProtocolChoiceController">
   <children>
      <Label layoutX="428.0" layoutY="59.0" prefHeight="48.0" prefWidth="467.0" text="Ative o protocolo que deseja utilizar">
         <font>
            <Font size="29.0" />
         </font>
      </Label>
      <CheckBox fx:id="tcpCheckBox" layoutX="634.0" layoutY="294.0" mnemonicParsing="false" onAction="#tcpChoice" text="TCP">
         <font>
            <Font name="System Bold" size="16.0" />
         </font></CheckBox>
      <CheckBox fx:id="rtuCheckBox" layoutX="630.0" layoutY="472.0" mnemonicParsing="false" onAction="#rtuChoice" prefHeight="34.0" prefWidth="65.0" text="RTU">
         <font>
            <Font name="System Bold" size="16.0" />
         </font></CheckBox>
      <Button layoutX="590.0" layoutY="566.0" mnemonicParsing="false" onAction="#irParaMain" prefHeight="34.0" prefWidth="145.0" text="Ir para página principal" />
      <Label layoutX="584.0" layoutY="372.0" prefHeight="25.0" prefWidth="158.0" text="Selecione a porta COM" textAlignment="JUSTIFY">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <ComboBox fx:id="comboPorts" layoutX="566.0" layoutY="427.0" onAction="#setSelectedPort" onKeyTyped="#setSelectedPort" prefHeight="25.0" prefWidth="122.0" />
      <Button fx:id="btnRefreshPorts" layoutX="696.0" layoutY="427.0" mnemonicParsing="false" text="Atualizar" />
      <Label layoutX="566.0" layoutY="397.0" text="antes de iniciar o serviço RTU">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label layoutX="455.0" layoutY="165.0" prefHeight="25.0" prefWidth="389.0" text="Digite as seguintes informações para usar o protocolo TCP" textAlignment="JUSTIFY">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtIpAddress" layoutX="487.0" layoutY="221.0" prefHeight="25.0" prefWidth="194.0" />
      <Label layoutX="455.0" layoutY="221.0" prefHeight="25.0" prefWidth="20.0" text="IP:" textAlignment="JUSTIFY">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtTcpPort" layoutX="763.0" layoutY="221.0" prefHeight="25.0" prefWidth="81.0" />
      <Label layoutX="707.0" layoutY="221.0" prefHeight="25.0" prefWidth="41.0" text="Porta:" textAlignment="JUSTIFY">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
