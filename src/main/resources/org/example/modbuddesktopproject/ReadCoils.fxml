<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="678.0" prefWidth="1151.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.modbuddesktopproject.controller.ModbusReadCoilsController">
   <children>
      <Label layoutX="313.0" layoutY="14.0" text="Function 01 - Read Coils">
         <font>
            <Font size="47.0" />
         </font>
      </Label>
      <Label layoutX="70.0" layoutY="172.0" prefHeight="27.0" prefWidth="110.0" text="Id do Escravo:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputSlaveId" layoutX="70.0" layoutY="203.0" onAction="#setSlaveId" onKeyTyped="#setSlaveId" />
      <TextField fx:id="inputAddress" layoutX="277.0" layoutY="203.0" onAction="#setAddress" onKeyTyped="#setAddress" />
      <Label layoutX="277.0" layoutY="173.0" prefHeight="27.0" prefWidth="79.0" text="Endereço:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="479.0" layoutY="173.0" prefHeight="27.0" prefWidth="173.0" text="Quantidade de bits:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputBitQuantity" layoutX="479.0" layoutY="203.0" onAction="#setBitQuantity" onKeyTyped="#setBitQuantity" prefHeight="25.0" prefWidth="173.0" />
      <Button fx:id="btnEnviar" layoutX="510.0" layoutY="287.0" mnemonicParsing="false" onAction="#sendReadCoilsRequest" prefHeight="47.0" prefWidth="110.0" text="Enviar">
         <font>
            <Font name="System Bold" size="23.0" />
         </font>
      </Button>
      <TextArea fx:id="txtAReceivedData" editable="false" layoutX="694.0" layoutY="197.0" prefHeight="102.0" prefWidth="406.0" />
      <Label layoutX="694.0" layoutY="170.0" prefHeight="27.0" prefWidth="150.0" text="Dados Recebidos">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextArea fx:id="txtAStatus" editable="false" layoutX="694.0" layoutY="339.0" prefHeight="165.0" prefWidth="406.0" />
      <Label layoutX="694.0" layoutY="311.0" prefHeight="27.0" prefWidth="79.0" text="Resposta">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button layoutX="65.0" layoutY="73.0" mnemonicParsing="false" onAction="#irParaMain" prefHeight="35.0" prefWidth="159.0" text="Voltar para Menu Principal" />
      <TextField fx:id="modeSelected" alignment="CENTER" disable="true" layoutX="458.0" layoutY="96.0" prefHeight="25.0" prefWidth="236.0">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </TextField>
   </children>
</AnchorPane>
