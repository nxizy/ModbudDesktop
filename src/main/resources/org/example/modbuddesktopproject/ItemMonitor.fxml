<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.modbuddesktopproject.controller.ItemMonitorController">
   <children>
      <Label layoutX="840.0" layoutY="56.0" text="Porta COM">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <ComboBox fx:id="comboPorts" layoutX="840.0" layoutY="83.0" onAction="#setSelectedPort" onKeyTyped="#setSelectedPort" prefHeight="26.0" prefWidth="321.0" />
      <Button fx:id="btnRefreshPorts" layoutX="1169.0" layoutY="84.0" mnemonicParsing="false" text="Atualizar" />
      <Button layoutX="79.0" layoutY="82.0" mnemonicParsing="false" onAction="#irParaMain" prefHeight="35.0" prefWidth="159.0" text="Voltar para Menu Principal" />
      <Label layoutX="433.0" layoutY="80.0" text="Monitor de Itens">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      <Label layoutX="335.0" layoutY="258.0" prefHeight="27.0" prefWidth="110.0" text="Id do Escravo">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputSlaveId" layoutX="335.0" layoutY="287.0" onAction="#setSlaveId" onKeyTyped="#setSlaveId" />
      <TextField fx:id="inputAddress" layoutX="661.0" layoutY="287.0" onAction="#setAddress" onKeyTyped="#setAddress" />
      <Label layoutX="661.0" layoutY="259.0" prefHeight="27.0" prefWidth="79.0" text="Endereço">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="814.0" layoutY="259.0" prefHeight="27.0" prefWidth="173.0" text="Quantidade de bits">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputBitQuantity" layoutX="814.0" layoutY="287.0" onAction="#setBitQuantity" onKeyTyped="#setBitQuantity" prefHeight="25.0" prefWidth="173.0" />
      <Label layoutX="486.0" layoutY="259.0" text="Função">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <ComboBox fx:id="comboFunctions" layoutX="486.0" layoutY="287.0" onAction="#setSelectedPort" onKeyTyped="#setSelectedPort" prefHeight="26.0" prefWidth="173.0" />
      <Label layoutX="195.0" layoutY="395.0" prefHeight="27.0" prefWidth="173.0" text="Resposta">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TableView fx:id="tblResponse" layoutX="195.0" layoutY="430.0" prefHeight="200.0" prefWidth="890.0">
        <columns>
          <TableColumn fx:id="nameColumn" prefWidth="145.0" text="Nome" />
            <TableColumn fx:id="slaveColumn" text="Escravo" />
          <TableColumn fx:id="functionColumn" prefWidth="107.0" text="Função" />
            <TableColumn fx:id="addressColumn" prefWidth="113.0" text="Endereço" />
            <TableColumn fx:id="valueColumn" prefWidth="306.0" text="Valor" />
            <TableColumn fx:id="timestampColumn" prefWidth="138.0" text="Horário" />
        </columns>
      </TableView>
      <Button fx:id="btnMonitor" layoutX="999.0" layoutY="285.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="126.0" text="Monitorar" />
      <Label layoutX="184.0" layoutY="258.0" prefHeight="27.0" prefWidth="110.0" text="Nome">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputMonitorName" layoutX="184.0" layoutY="287.0" onAction="#setName" onKeyTyped="#setName" />
   </children>
</AnchorPane>
