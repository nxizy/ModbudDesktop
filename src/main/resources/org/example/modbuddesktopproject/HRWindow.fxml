<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.modbuddesktopproject.controller.ModbusController">
   <children>
      <Label layoutX="431.0" layoutY="39.0" prefHeight="58.0" prefWidth="418.0" text="Função Read Holding Registers" textAlignment="CENTER">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      <Label layoutX="130.0" layoutY="360.0" text="Porta COM">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <ComboBox fx:id="comboPorts" layoutX="130.0" layoutY="387.0" onAction="#setSelectedPort" onKeyTyped="#setSelectedPort" prefHeight="26.0" prefWidth="321.0" />
      <Button fx:id="btnRefreshPorts" layoutX="459.0" layoutY="388.0" mnemonicParsing="false" text="Atualizar" />
      <Button fx:id="btnEnviar" layoutX="603.0" layoutY="533.0" mnemonicParsing="false" onAction="#sendModbusRequest" prefHeight="47.0" prefWidth="110.0" text="Enviar">
         <font>
            <Font name="System Bold" size="23.0" />
         </font></Button>
      <Label layoutX="130.0" layoutY="214.0" prefHeight="27.0" prefWidth="110.0" text="Id do Escravo">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputSlaveId" layoutX="130.0" layoutY="245.0" onAction="#setSlaveId" onKeyTyped="#setSlaveId" />
      <TextField fx:id="inputAddress" layoutX="337.0" layoutY="245.0" onAction="#setAddress" onKeyTyped="#setAddress" />
      <Label layoutX="337.0" layoutY="215.0" prefHeight="27.0" prefWidth="79.0" text="Endereço">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="539.0" layoutY="215.0" prefHeight="27.0" prefWidth="173.0" text="Quantidade de bits">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputBitQuantity" layoutX="539.0" layoutY="245.0" onAction="#setBitQuantity" onKeyTyped="#setBitQuantity" prefHeight="25.0" prefWidth="173.0" />
      <TextArea fx:id="txtASentData" editable="false" layoutX="801.0" layoutY="242.0" prefHeight="102.0" prefWidth="406.0" />
      <TextArea fx:id="txtAReceivedData" editable="false" layoutX="801.0" layoutY="387.0" prefHeight="102.0" prefWidth="406.0" />
      <TextArea fx:id="txtAStatus" editable="false" layoutX="801.0" layoutY="532.0" prefHeight="50.0" prefWidth="406.0" />
      <Label layoutX="801.0" layoutY="504.0" prefHeight="27.0" prefWidth="79.0" text="Resposta">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="801.0" layoutY="360.0" prefHeight="27.0" prefWidth="150.0" text="Dados Recebidos">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="801.0" layoutY="214.0" prefHeight="27.0" prefWidth="150.0" text="Dados Enviados">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button layoutX="59.0" layoutY="62.0" mnemonicParsing="false" onAction="#irParaMain" prefHeight="35.0" prefWidth="159.0" text="Voltar para Menu Principal" />
   </children>
</AnchorPane>
