<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="678.0" prefWidth="1151.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.modbuddesktopproject.controller.ReadCoilsController">
   <children>
      <Label layoutX="313.0" layoutY="14.0" text="Function 01 - Read Coils">
         <font>
            <Font size="47.0" />
         </font>
      </Label>
      <Label layoutX="70.0" layoutY="172.0" prefHeight="27.0" prefWidth="110.0" text="Id do Escravo:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputSlaveId" layoutX="70.0" layoutY="203.0" onAction="#setSlaveId" onKeyTyped="#setSlaveId" />
      <TextField fx:id="inputAddress" layoutX="277.0" layoutY="203.0" onAction="#setAddress" onKeyTyped="#setAddress" />
      <Label layoutX="277.0" layoutY="173.0" prefHeight="27.0" prefWidth="79.0" text="Endereço:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="479.0" layoutY="173.0" prefHeight="27.0" prefWidth="173.0" text="Quantidade de bits:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="inputBitQuantity" layoutX="479.0" layoutY="203.0" onAction="#setBitQuantity" onKeyTyped="#setBitQuantity" prefHeight="25.0" prefWidth="173.0" />
      <Label layoutX="70.0" layoutY="272.0" text="Porta COM">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <ComboBox fx:id="comboPorts" layoutX="70.0" layoutY="299.0" onAction="#setSelectedPort" prefHeight="26.0" prefWidth="321.0" />
      <Button fx:id="btnRefreshPorts" layoutX="399.0" layoutY="300.0" mnemonicParsing="false" text="Atualizar" />
      <Button fx:id="btnEnviar" layoutX="510.0" layoutY="287.0" mnemonicParsing="false" onAction="#sendReadCoilsRequest" prefHeight="47.0" prefWidth="110.0" text="Enviar">
         <font>
            <Font name="System Bold" size="23.0" />
         </font>
      </Button>
      <TextArea fx:id="txtASentData" editable="false" layoutX="692.0" layoutY="201.0" prefHeight="102.0" prefWidth="406.0" />
      <Label layoutX="692.0" layoutY="173.0" prefHeight="27.0" prefWidth="150.0" text="Dados Enviados">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextArea fx:id="txtAReceivedData" editable="false" layoutX="692.0" layoutY="350.0" prefHeight="102.0" prefWidth="406.0" />
      <Label layoutX="692.0" layoutY="323.0" prefHeight="27.0" prefWidth="150.0" text="Dados Recebidos">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextArea fx:id="txtAStatus" editable="false" layoutX="692.0" layoutY="492.0" prefHeight="165.0" prefWidth="406.0" />
      <Label layoutX="692.0" layoutY="464.0" prefHeight="27.0" prefWidth="79.0" text="Resposta">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
